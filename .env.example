# --- Búsqueda de Idealista ---
# Pega aquí la URL de tu búsqueda. El bot le añade el orden por fecha si no lo tiene.
SEARCH_URL=https://www.idealista.com/alquiler-viviendas/madrid-madrid/con-precio-hasta_1500,metros-cuadrados-mas-de_40/

# --- Frecuencia de chequeo ---
# Minutos base entre chequeos. El bot añade jitter aleatorio (POLL_JITTER_MIN)
# para que el patrón de tráfico no sea robótico.
POLL_INTERVAL_MIN=30
POLL_JITTER_MIN=5

# --- Horario activo ---
# 6 a 2 = activo de 06:00 a 02:00 (no alerta de 2am a 6am, hora de España).
ACTIVE_START_HOUR=6
ACTIVE_END_HOUR=2
# Zona horaria fija: funciona igual en tu Mac o en un VPS en UTC.
TIMEZONE=Europe/Madrid

# --- Bright Data Web Unlocker (para saltar DataDome) ---
# 1. Crea cuenta en https://brightdata.com
# 2. Crea una zona de tipo "Web Unlocker" en el panel.
# 3. BRIGHTDATA_ZONE = el nombre de esa zona.
# 4. BRIGHTDATA_API_KEY = tu API token (Account settings -> API tokens).
# Pagas solo los requests que salen bien (~$1,5-3 / 1.000).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# --- Borrador del mensaje ---
# template = plantilla fija (sin key, sin coste)  <-- por defecto, para probar
# claude   = mensaje personalizado con IA (necesita ANTHROPIC_API_KEY)
# none     = sin borrador, solo el aviso del anuncio
DRAFT_MODE=template

# Solo si DRAFT_MODE=claude: API key de https://console.anthropic.com (o `ant auth login`)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Telegram (para avisarte) ---
# 1. Habla con @BotFather en Telegram -> /newbot -> te da el token.
# 2. Escríbele algo a tu bot, y saca tu chat_id de:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Datos para el borrador del mensaje ---
TENANT_NAME=Agustina
TENANT_PROFILE=Profesional con contrato indefinido, sin mascotas, no fumadora. Puedo visitar entre semana por la tarde o el fin de semana.
